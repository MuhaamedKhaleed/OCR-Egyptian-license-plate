# OCR_DATA_YAML=/absolute/path/to/permitted/data.yaml
# OCR_BASE_WEIGHTS=/absolute/path/to/trusted/base.pt
# OCR_TRAIN_OUTPUT=/absolute/path/to/new-run
# OCR_EPOCHS=1
